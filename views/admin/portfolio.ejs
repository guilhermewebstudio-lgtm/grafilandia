<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>
<main id="main" class="admin">
<div class="wrap">
  <h1>Portefólio</h1>
  <p class="muted">Adiciona fotos reais dos trabalhos (JPG, PNG, WEBP ou GIF, até 6 MB cada, até 12 de uma vez). Enquanto não houver fotos, o site mostra espaços reservados.</p>

  <form class="card-form" method="post" action="/admin/portfolio" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row3">
      <div class="field"><label>Imagens</label><input type="file" name="imagens" accept="image/jpeg,image/png,image/webp,image/gif" multiple required></div>
      <div class="field"><label>Título <span class="opt">(vazio = nome do ficheiro)</span></label><input name="title" maxlength="100"></div>
      <div class="field"><label>Categoria <span class="opt">(ex.: Cartões de visita)</span></label><input name="category" maxlength="60"></div>
    </div>
    <button class="btn btn-primary" type="submit"><%- icon('upload') %>Carregar</button>
  </form>

  <div class="admin-pf">
    <% rows.forEach(function (r) { %>
    <div class="admin-pf-item">
      <img src="/media/<%= r.media_id %>" alt="<%= r.title %>" loading="lazy">
      <form method="post" action="/admin/portfolio/<%= r.id %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label>Título</label><input name="title" value="<%= r.title %>" maxlength="100"></div>
        <div class="field"><label>Categoria</label><input name="category" value="<%= r.category %>" maxlength="60"></div>
        <div class="field"><label>Ordem</label><input name="sort_order" type="number" value="<%= r.sort_order %>"></div>
        <button class="btn btn-primary btn-sm" type="submit">Guardar</button>
      </form>
      <form method="post" action="/admin/portfolio/<%= r.id %>/apagar" data-confirm="Apagar esta imagem?">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-danger btn-sm" type="submit"><%- icon('trash') %>Apagar</button>
      </form>
    </div>
    <% }) %>
  </div>
  <% if (!rows.length) { %><p class="muted">Ainda não carregaste nenhuma imagem.</p><% } %>
</div>
</main>
<%- include('../partials/foot') %>
