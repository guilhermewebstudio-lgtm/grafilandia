<%- include('partials/head') %>
<main id="main">
<section class="page-head">
  <div class="wrap">
    <h1>Serviços</h1>
    <p class="lead">Tudo o que imprimimos, organizado por tipo de trabalho. Escolhe um e pede o orçamento já com o produto selecionado.</p>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <ul class="index index-big">
      <% services.forEach(function (sv) { %>
      <li class="rv">
        <a class="index-row" href="/orcamento?produto=<%= encodeURIComponent(sv.name) %>">
          <% if (sv.media_id) { %><img class="index-img" src="/media/<%= sv.media_id %>" alt="" loading="lazy"><% } else { %><span class="index-ico"><%- icon(sv.icon) %></span><% } %>
          <span class="index-name"><%= sv.name %></span>
          <span class="index-desc"><%= sv.description %></span>
          <span class="index-go">Pedir orçamento<%- icon('arrow') %></span>
        </a>
      </li>
      <% }) %>
    </ul>
    <div class="note-box rv">
      <h2>Não encontras o que procuras?</h2>
      <p>Diz-nos o que precisas. Se for possível fazer, dizemos-te como e quanto custa.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/orcamento?produto=Outro%20trabalho">Pedir orçamento</a>
        <% if (s.whatsapp) { %><a class="btn btn-wa" href="<%= waLink('Olá! Gostava de saber se conseguem fazer um trabalho diferente.') %>" target="_blank" rel="noopener"><%- icon('whatsapp') %>WhatsApp</a><% } %>
      </div>
    </div>
  </div>
</section>
</main>
<%- include('partials/foot') %>
