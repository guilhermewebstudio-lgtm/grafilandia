<%- include('../partials/head') %>
<main id="main">
<section class="section">
  <div class="wrap auth-wrap">
    <form class="form auth-card" action="/registar" method="post">
      <h1>Criar conta</h1>
      <p class="muted">Com conta podes acompanhar o estado dos teus pedidos. Não é obrigatória para pedir orçamentos.</p>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label for="name">Nome</label><input id="name" name="name" type="text" autocomplete="name" required maxlength="100"></div>
      <div class="field"><label for="email">E-mail</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="150"></div>
      <div class="field"><label for="password">Palavra-passe <span class="opt">(mínimo 8 caracteres)</span></label><input id="password" name="password" type="password" autocomplete="new-password" required minlength="8"></div>
      <div class="field"><label for="confirm">Repetir palavra-passe</label><input id="confirm" name="confirm" type="password" autocomplete="new-password" required minlength="8"></div>
      <button class="btn btn-primary btn-block" type="submit">Criar conta</button>
      <p class="auth-links"><a href="/entrar">Já tenho conta</a></p>
    </form>
  </div>
</section>
</main>
<%- include('../partials/foot') %>
